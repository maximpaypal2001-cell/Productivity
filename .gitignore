# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env files (contain secrets — never commit)
.env
.env.local
.env.*.local

# local database and uploaded files
/data/
# built portable Windows package (large binaries — built on demand, not committed)
/dist/
# Prisma resolves sqlite paths relative to prisma/schema.prisma, so the
# actual db file lives inside prisma/ — never commit it.
/prisma/*.db
/prisma/*.db-journal

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts
