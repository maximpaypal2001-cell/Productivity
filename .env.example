# Локальная база данных (SQLite-файл, хранится в prisma/dev.db). Менять не обязательно.
DATABASE_URL="file:./dev.db"

# Секретный ключ для подписи сессий входа. Генерируется автоматически
# командой `npm install` (см. scripts/setup-env.mjs) — вручную менять не нужно.
AUTH_SECRET="replace-with-a-long-random-string"
